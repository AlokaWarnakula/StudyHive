{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "studyhive",
    "Audience": "studyhive-clients",
    "SigningKey": ""
  },
  "WorkflowLimits": {
    "ToolCallTimeoutSeconds": 15,
    "SingleAgentTimeoutSeconds": 45,
    "WholeWorkflowTimeoutSeconds": 180,
    "MaxRetriesPerStep": 2,
    "MaxLlmTokensPerRun": 8000
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
