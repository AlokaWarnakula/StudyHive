# StudyHive environment template
#
# Copy this file to .env and fill in real values. .env is gitignored (.gitignore already covers
# .env, .env.local and *.env, with !.env.example so this template stays tracked). Never commit a
# real connection string, signing key or API key.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------------------------
# HOW THESE REACH THE APP
#
# .NET maps environment variables to configuration by replacing ":" with "__" (two underscores).
# So ConnectionStrings__Default overrides the "ConnectionStrings:Default" value in appsettings.
# Environment variables win over appsettings.json, which is what makes this file work without
# editing any committed config.
#
# There is no automatic .env loader in the API. Load it into your shell before running:
#
#   PowerShell:  Get-Content .env | Where-Object {$_ -notmatch '^\s*#' -and $_ -match '='} |
#                  ForEach-Object { $n,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($n,$v) }
#   bash:        set -a && source .env && set +a
#
# ---------------------------------------------------------------------------------------------

# --- DATABASE ---------------------------------------------------------------------------------
# Local Docker (the default in appsettings.Development.json — you do not need to set this to use it):
#   ConnectionStrings__Default=Host=localhost;Port=5432;Database=studyhive;Username=studyhive;Password=studyhive_dev
#
# Neon (hosted PostgreSQL). Take the connection details from your Neon dashboard.
# Neon requires TLS, so SSL Mode=Require is not optional. Npgsql wants the key=value form below,
# not the postgresql:// URL Neon shows by default — translate it.
#
# Neon gives you:  postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Npgsql wants:    Host=HOST;Database=DBNAME;Username=USER;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true
#
ConnectionStrings__Default=Host=<your-endpoint>.<region>.aws.neon.tech;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# --- AUTH -------------------------------------------------------------------------------------
# Minimum 32 bytes. Generate a fresh one, never reuse the development key:
#   openssl rand -base64 48
Jwt__SigningKey=<generate-a-random-key-at-least-32-bytes>
Jwt__Issuer=studyhive
Jwt__Audience=studyhive-clients

# --- AGENT SERVICE ----------------------------------------------------------------------------
# The FastAPI planner. Internal only — never expose it publicly.
Agent__BaseUrl=http://localhost:8001
Agent__InternalApiKey=<generate-a-random-key>

# Optional. Leave empty and the Planner runs fully deterministically, which is the default and is
# what every test uses. A key only adds a short display summary; it never decides eligibility.
GEMINI_API_KEY=

# --- HOSTING ----------------------------------------------------------------------------------
# Outside Development the API refuses to start if this is "*". Set explicit hosts.
AllowedHosts=<your-domain.com>

# Comma-free JSON array indexing is how .NET binds list values from environment variables:
Cors__AllowedOrigins__0=https://<your-web-app-domain>
