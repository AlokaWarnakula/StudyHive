GROQ_API_KEY=
# Must match PLACEHOLDER_INTERNAL_API_KEY in app/settings.py exactly — that's what the startup
# guard checks for. If you change this to a real secret, ENVIRONMENT can be anything.
INTERNAL_API_KEY=dev-only-internal-key-DO-NOT-USE-IN-PRODUCTION

# Defaults to "production" (fail-safe) when unset. "development" is the only value that allows
# INTERNAL_API_KEY to be left at its placeholder — any other value makes a missing or still-default
# key a startup error.
ENVIRONMENT=development

# --- xAI Grok (the LLM for the agents) ------------------------------------------------------
# Paste ONE of your xAI API keys (console.x.ai -> API Keys). Leave blank and every agent stays
# fully deterministic, which is also what all tests use. Never commit a real key. With a key set,
# the Planner adds a one-line Grok summary of the student's objective — see app/llm.py and
# summarize_objective() in app/agents/planner.py for exactly what that call can influence.
GROK_API_KEY=
# OpenAI-compatible endpoint. Only change this if xAI moves it.
GROK_BASE_URL=https://api.x.ai/v1
# Pick the cheapest "mini"/"fast" model your console lists. Blank = the default in app/settings.py.
GROK_MODEL=
