GROQ_API_KEY=
# Optional. Leave blank to keep the Planner fully deterministic (default, and what every test in
# agent/tests/test_planner.py runs against). Set a real key (one Google AI Studio key is enough for
# the whole service — it authenticates the project, not any one agent) to additionally have the
# Planner ask Gemini for a short display summary of the student's objective — see
# summarize_objective() in app/agents/planner.py for exactly what that call can and cannot influence.
GEMINI_API_KEY=
# Optional. Defaults to DEFAULT_GEMINI_MODEL in app/settings.py if unset or blank — override only if
# your Google AI Studio account needs a different Gemini Flash model id (Google occasionally retires
# model ids; if summarize_objective() starts logging warnings, this is the first thing to check).
GEMINI_MODEL=
# Must match PLACEHOLDER_INTERNAL_API_KEY in app/settings.py exactly — that's what the startup
# guard checks for. If you change this to a real secret, ENVIRONMENT can be anything.
INTERNAL_API_KEY=dev-only-internal-key-DO-NOT-USE-IN-PRODUCTION

# Defaults to "production" (fail-safe) when unset. "development" is the only value that allows
# INTERNAL_API_KEY to be left at its placeholder — any other value makes a missing or still-default
# key a startup error.
ENVIRONMENT=development
